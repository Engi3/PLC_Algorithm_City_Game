            {
              "id": "stage3",
              "name": "ขั้นที่ 3: ทดสอบความปลอดภัย - ตรวจพบชิ้นงานเสียขณะม่านแสงมีสิ่งกีดขวาง",
              "frames": [{ "inputs": { "I1": true, "I2": true, "I3": false, "I4": true }, "ticks": 1 }],
              "expect": [{ "kind": "bit", "address": "Q0", "expected": false }]
            }
          ]
        }
      ]
    }

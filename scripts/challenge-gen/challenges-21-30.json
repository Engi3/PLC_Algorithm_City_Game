            {
              "id": "stage1",
              "name": "ขั้นที่ 1: ตรวจพบชิ้นงานเสียชิ้นแรก - ตัวดันทำงานครบรอบ",
              "frames": [
                { "inputs": { "I1": true, "I2": true, "I3": false, "I4": false }, "ticks": 1 },
                { "inputs": { "I1": false, "I2": false, "I3": true, "I4": false }, "ticks": 6 },
                { "inputs": { "I1": false, "I2": true, "I3": false, "I4": false }, "ticks": 1 }
              ],
              "expect": [
                { "kind": "bit", "address": "Q0", "expected": false },
                { "kind": "numeric", "address": "C0.ACC", "operator": "==", "value": 1 }
              ]
            },
            {
              "id": "stage2",
              "name": "ขั้นที่ 2: ตรวจพบชิ้นงานเสียชิ้นที่สอง - ตัวดันทำงานครบรอบอีกครั้ง",
              "frames": [
                { "inputs": { "I1": true, "I2": true, "I3": false, "I4": false }, "ticks": 1 },
                { "inputs": { "I1": false, "I2": false, "I3": true, "I4": false }, "ticks": 6 },
                { "inputs": { "I1": false, "I2": true, "I3": false, "I4": false }, "ticks": 1 }
